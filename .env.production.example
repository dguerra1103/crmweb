# Copia este archivo como .env en el VPS (dentro de la carpeta del proyecto)
# y rellena cada valor. Nunca subas el .env real a git.

# Cadena de conexión de Neon (Postgres). Cópiala del panel de Neon:
# Dashboard → tu proyecto → Connection string → modo "Pooled connection".
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Genera cada secreto con: openssl rand -base64 32
AUTH_SECRET=""
WA_WORKER_SECRET=""
CRON_SECRET=""

# URL pública por la que el worker de WhatsApp le habla al CRM.
# Como corren en el mismo VPS, siempre es localhost aunque el sitio
# se vea desde afuera por la IP del servidor. Debe coincidir con el
# puerto de ecosystem.config.js (3001 si el 3000 lo usa EasyPanel u otro panel).
CRM_URL="http://localhost:3001"

# Al menos una de las dos, según qué IA vayas a usar (se elige en Ajustes → Asistente IA).
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Solo si usas WhatsApp Cloud API en vez del QR (requiere dominio con HTTPS).
META_VERIFY_TOKEN=""
